[About]
Type=label
Label=About
Category=About Plugin
CategoryOrder=-1
Index=0
Default=ComfyUI plugin for Deadline. Renders a workflow.json file using ComfyUI portable.
Description=Not configurable

[ConcurrentTasks]
Type=label
Label=ConcurrentTasks
Category=About Plugin
CategoryOrder=-1
Index=0
Default=True
Description=Not configurable

[ComfyUIPath]
Type=multilinemultifilename
Label=ComfyUI Installation Paths
Category=Configuration
Index=0
Default=C:\\ComfyUI_windows_portable
Description=One path per line (local drive letters, UNC paths, etc). Workers try each entry in order and pick the first install that contains ComfyUI\\main.py and python_embeded\\python.exe.

[DefaultOutputDirectory]
Type=filename
Label=Default Output Directory (Optional)
Category=Configuration
Index=1
Default=
Description=Optional default for jobs without an output path. This directory is also approved storage. ComfyUI users enter full output paths in the submit node.

[AllowedStorageRoots]
Type=multilinestring
Label=Allowed Storage Locations (Optional)
Category=Configuration
Index=3
Default=G:\*;X:\input\*;X:\outputs\*;X:\playground\*;Y:\*;\\NAS02\grajdolek\*;\\NAS02\Comfy\input\*;\\NAS02\Comfy\outputs\*;\\NAS02\Comfy\playground\*;\\NAS04\3d-02\*
Description=Approved input and output locations, one per line. Both drive-letter and UNC rules are supported. Mapped network paths are converted to UNC before submission and checked against the UNC rules. A folder also allows all its subfolders. Default Output Directory and local ComfyUI input/output folders are already allowed.

[ComfyUIWorkerEndpoints]
Type=multilinestring
Label=Per-Worker ComfyUI Endpoints
Category=Configuration
Index=2
Default={}
Description=Optional JSON keyed by worker name. Example: {"M28":{"ComfyUIApiUrl":"http://127.0.0.1:8188","LaunchGpuUuid":"GPU-..."}}. A verified endpoint is reused; fallback launches only at that port and resolves the UUID.
